# Copy to .env for `npm run dev`. .env is git-ignored: never commit it.
PORT=3003
NODE_ENV=development
SERVICE_NAME=visits
CORS_ORIGINS=http://localhost:8080,http://localhost:4566
VISITS_TABLE=ShelterVisits
EVENT_BUS_NAME=shelter-bus
EVENT_SOURCE=shelter.visits
RESEND_SECRET_ID=shelter/resend
REMINDER_MINUTES_BEFORE=1440
# Set by infra/deploy.sh on the Lambda (left empty on a PC: no reminders scheduled)
VISITS_FUNCTION_ARN=
SCHEDULER_ROLE_ARN=
# Shared API Gateway URL (used to call the Animals and Applications services)
API_BASE_URL=http://YOUR-API-ID.execute-api.localhost.floci.io:4566
COGNITO_ISSUER=http://localhost:4566/us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=
COGNITO_JWKS_URL=http://localhost:4566/us-east-1_XXXXXXXXX/.well-known/jwks.json
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Demo only: small values let you record a visit outcome without waiting an hour
VISIT_LEAD_MINUTES=60
SLOT_STEP_MINUTES=30
