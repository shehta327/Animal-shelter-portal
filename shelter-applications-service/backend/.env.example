# Copy to .env for `npm run dev`. .env is git-ignored: never commit it.
PORT=3002
NODE_ENV=development
SERVICE_NAME=applications
CORS_ORIGINS=http://localhost:8080,http://localhost:4566
EVENT_BUS_NAME=shelter-bus
EVENT_SOURCE=shelter.applications
# Local only: Neon connection string (SECRET). On Lambda it comes from Secrets Manager (DB_SECRET_ID).
DATABASE_URL=
DB_SECRET_ID=shelter/applications-db
RESEND_SECRET_ID=shelter/resend
# Shared API Gateway URL (used to call the Animals service)
API_BASE_URL=http://YOUR-API-ID.execute-api.localhost.floci.io:4566
# Optional: open the TCP connection somewhere else when the gateway host does not resolve (e.g. http://localhost:4566)
API_CONNECT_URL=
COGNITO_ISSUER=http://localhost:4566/us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=
COGNITO_JWKS_URL=http://localhost:4566/us-east-1_XXXXXXXXX/.well-known/jwks.json
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
