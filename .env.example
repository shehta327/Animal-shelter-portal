# Configuration needed to run the whole portal on Floci.
# PLACEHOLDERS ONLY. Never put real values in this file or anywhere in the repository.
#
# The deployed system does NOT read a .env file. The two real secrets below are typed
# (hidden) into AWS Secrets Manager on Floci with the scripts named next to them, and the
# Lambdas read them at runtime. Everything else is created by the deploy scripts.
# Each service also has backend/.env.example for running it on a PC with `npm run dev`.

# --- 1. Neon Postgres (REQUIRED for the Adoption Applications service) -----------------
# Use your own free Neon database (https://neon.tech):
#   a. In the Neon SQL Editor, as the owner, run
#        shelter-applications-service/backend/db/schema.sql   (or: npm run migrate with the owner URL)
#      then create the app_api login (see the first lines of db/roles.sql) and run db/roles.sql.
#   b. Store the app_api connection string in Secrets Manager (input is hidden):
#        cd shelter-applications-service ; .\infra\run.ps1 set-db-secret.sh
# Stored as secret: shelter/applications-db   {"url": "..."}
DATABASE_URL=postgresql://app_api:<password>@<host>.neon.tech/<database>?sslmode=require

# --- 2. Resend email API (OPTIONAL) ------------------------------------------------------
# Without a real key every feature still works; emails are skipped and logged.
# Free sender onboarding@resend.dev only delivers to your own Resend account email,
# so set the test recipient to that address.
#   .\infra\run.ps1 set-resend-key.sh      (from the repo root, input is hidden)
# Stored as secret: shelter/resend   {"apiKey": "...", "from": "...", "testRecipient": "..."}
RESEND_API_KEY=re_<your-resend-api-key>
RESEND_FROM=onboarding@resend.dev
RESEND_TEST_RECIPIENT=<your-resend-account-email>

# --- 3. AWS / Floci (not secrets) --------------------------------------------------------
# Floci accepts any credentials; the scripts already use these dummy values.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- 4. Created automatically (do not set by hand) ---------------------------------------
# infra/platform.sh writes infra/out/platform.env (git-ignored) with:
#   USER_POOL_ID, COGNITO_CLIENT_ID, COGNITO_ISSUER, API_ID, API_URL, WEBSITE
# and infra/out/seed-users.txt (git-ignored) with fresh random passwords for the demo accounts:
#   admin@shelter.test (Admin), staff@shelter.test (Staff), adopter1@shelter.test, adopter2@shelter.test
