# Copy to .env for `npm run dev` against Floci. .env is git-ignored: never commit it.
# None of these are secrets: Floci uses the dummy keys "test"/"test".
PORT=3001
NODE_ENV=development
SERVICE_NAME=animals
CORS_ORIGINS=http://localhost:8080,http://localhost:4566
ANIMALS_TABLE=ShelterAnimals
PHOTOS_BUCKET=shelter-animal-photos
EVENT_BUS_NAME=shelter-bus
EVENT_SOURCE=shelter.animals
# Filled by infra/deploy.sh output (Cognito pool + client from the shelter-web platform)
COGNITO_ISSUER=http://localhost:4566/us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=
COGNITO_JWKS_URL=http://localhost:4566/us-east-1_XXXXXXXXX/.well-known/jwks.json
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
